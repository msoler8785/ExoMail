<?xml version="1.0" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      internalLogFile="nlog.log" intenalLogLevel="trace">
  <targets>
    <target name="allfile" xsi:type="AsyncWrapper" queueLimit="5000" overflowAction="Grow">
      <target xsi:type="File" fileName="${basedir}/Logs/${shortdate}-all.log" />
    </target>
    <target name="smtpclient" xsi:type="AsyncWrapper" queueLimit="5000" overflowAction="Grow">
      <target xsi:type="File" fileName="${basedir}/Logs/${shortdate}-smtp-client-protocol.log" />
    </target>
    <target name="smtpsession" xsi:type="AsyncWrapper" queueLimit="5000" overflowAction="Grow">
      <target xsi:type="File" fileName="${basedir}/Logs/${shortdate}-smtp-server-protocol.log" />
    </target>
    <target name="smtp.server" xsi:type="AsyncWrapper" queueLimit="5000" overflowAction="Grow">
      <target xsi:type="File" fileName="${basedir}/Logs/${shortdate}-smtp-server-all.log" />
    </target>
    <target name="smtp.client" xsi:type="AsyncWrapper" queueLimit="5000" overflowAction="Grow">
      <target xsi:type="File" fileName="${basedir}/Logs/${shortdate}-smtp-client-all.log" />
    </target>
    <target name="smtp.queueprocessor" xsi:type="AsyncWrapper" queueLimit="5000" overflowAction="Grow">
      <target xsi:type="File" fileName="${basedir}/Logs/${shortdate}-smtp-queue-all.log" />
    </target>
    <target name="smtp.service" xsi:type="AsyncWrapper" queueLimit="5000" overflowAction="Grow">
      <target xsi:type="File" fileName="${basedir}/Logs/${shortdate}-smtp-service-all.log" />
    </target>
  </targets>
  <rules>
    <logger name="*" minlevel="warn" writeTo="allfile" />
    <logger name="*SmtpClient" minlevel="trace" writeTo="smtpclient" />
    <logger name="*SmtpSession" minlevel="trace" writeTo="smtpsession" />
    <logger name="*Smtp.Server*" minlevel="warn" writeTo="smtp.server" />
    <logger name="*Smtp.QueueProcessor*" minlevel="warn" writeTo="smtp.queueprocessor" />
    <logger name="*Smtp.Service*" minlevel="trace" writeTo="smtp.service" />
    <logger name="*Smtp.Client*" minlevel="warn" writeTo="smtp.client" />
  </rules>
</nlog>